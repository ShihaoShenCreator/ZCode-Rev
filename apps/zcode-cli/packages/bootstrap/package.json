{
  "name": "@s-agent/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v4-replay": {
      "types": "./dist/zcode-protocol-v4/replay.d.ts",
      "import": "./dist/zcode-protocol-v4/replay.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test": "vitest tests",
    "test:fault-matrix": "ZCODE_FAULT_MATRIX=full vitest run tests/workflow-fault-matrix tests/fault-matrix-harness.test.ts tests/fake-provider-server.test.ts",
    "coverage": "vitest run tests --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@s-agent/adapters": "workspace:*",
    "@s-agent/contracts": "workspace:*",
    "@s-agent/core": "workspace:*",
    "@s-agent/dynamic-workflow": "workspace:*",
    "@s-agent/dynamic-workflow-runtime": "workspace:*",
    "@s-agent/i18n": "workspace:*",
    "@s-agent/provider": "workspace:*",
    "@s-agent/provider-node": "workspace:*",
    "@s-agent/shared": "workspace:*",
    "@s-agent/telemetry": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yazl": "^3.3.1",
    "@s-agent/formal-proof": "workspace:*",
    "yazl": "^3.3.1"
  }
}
